# Local Hugging Face model cache (see model_utils.py's HF_HOME
# requirement) — this holds multi-GB model checkpoints and must never
# be committed. Point HF_HOME at a folder like this to skip
# re-downloading weights on every run; set HF_HUB_OFFLINE=1 too once
# it's populated to skip the network freshness check entirely.
hf_cache/