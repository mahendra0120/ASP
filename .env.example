# Copy to .env and fill in real values — .env is gitignored, never commit it.
#
# HF_TOKEN is a credential: keep it in this file only, never in a
# script. It's only used for the FIRST download of a private/gated
# model repo; once weights are cached under HF_HOME the app runs with
# HF_HUB_OFFLINE=1 and never touches it.
HF_TOKEN=

# Non-secret config. setup_env.sh already sets these — only override
# here if your setup differs.
HF_HOME=/workspace/hf_cache
PROFILER_AGENT_PORT=8011
FORENSIC_AGENT_PORT=8002

# db.py's result store. Matches the credentials in setup_postgres.sh;
# db.py defaults to this same URL if unset.
DATABASE_URL=postgresql://asp_user:asp_password@localhost:5432/asp
